# ─────────────────────────────────────────────────────────────
# إعدادات البيئة المحلية — للعمل أثناء التطوير فقط.
# انسخ هذا الملف إلى `.env` وعدّل القيم حسب الحاجة.
# لا ترفع قيم الإنتاج الحقيقية إلى المستودع أبداً.
# ─────────────────────────────────────────────────────────────

# مفتاح سري — في الإنتاج استخدم قيمة قوية وعشوائية طويلة.
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret

# True للعمل المحلي، False للإنتاج.
DJANGO_DEBUG=True

# نطاقات معتمدة مفصولة بفواصل (يُشترط ضبطها عندما DEBUG=False).
# مثال: api.example.com,myapp.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# أصول الـ Frontend المسموح لها الاتصال بالـ API (CORS) مفصولة بفواصل.
# مثال: https://example.com,https://myapp.vercel.app
DJANGO_CORS_ORIGINS=http://localhost:5173

# قاعدة بيانات PostgreSQL (Neon / Supabase / Render ...).
# عند تركها فارغة يعمل المشروع على SQLite محلياً.
DATABASE_URL=

# يفعّل أمان HTTPS (إعادة التوجيه، كوookie آمن، HSTS...). الافتراضي يتبع DJANGO_DEBUG.
# DJANGO_SECURE=False

# يشترط SSL عند الاتصال بقاعدة البيانات (فعّله مع Neon/Supabase إن لم تكن في الرابط).
# DJANGO_DB_SSL=True

# ─────────────────────────────────────────────────────────────
# بيانات حساب الأدمن — تُنشأ فقط إذا لم يكن المستخدم موجوداً.
# DJANGO_ADMIN_PASSWORD لا تُستخدم أبداً لتغيير كلمة مرور مستخدم موجود.
# ─────────────────────────────────────────────────────────────
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=
